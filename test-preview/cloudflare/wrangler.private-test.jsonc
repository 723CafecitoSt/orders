{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"723-orders-private-test",
 "main":"src/worker.mjs",
 "compatibility_date":"2026-10-01",
 "workers_dev":false,
 "preview_urls":false,
 "limits":{"cpu_ms":1000},
 "observability":{"enabled":false},
 "d1_databases":[{"binding":"DB","database_name":"723-orders-private-test","database_id":"00000000-0000-4000-8000-000000000000","migrations_dir":"migrations"}],
 "vars":{
  "APP_MODE":"private_test",
  "TEST_ENABLED":"false",
  "PAYMENTS_ENABLED":"false",
  "TEST_DATABASE_ID":"REPLACE_WITH_TEST_D1_ID",
  "TEST_FRONTEND_ORIGIN":"https://orders-test.723cafecitost.com",
  "TEST_API_ORIGIN":"https://orders-api-test.723cafecitost.com"
 }
}
