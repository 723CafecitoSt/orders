{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "order-station-sandbox-review",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "723-order-sandbox", "database_id": "REPLACE_WITH_SANDBOX_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "vars": { "APP_MODE": "simulation" }
}
